# Narrow contract for the two CustomPass display shaders. Reflection checks
# layout only; graph resource access is still declared explicitly by each Pass.
function(display_contract_error reason)
    message(FATAL_ERROR "Display Shader contract rejected: ${reason}")
endfunction()
function(json_count output json key)
    string(JSON count ERROR_VARIABLE error LENGTH "${json}" "${key}")
    if(error)
        set(count 0)
    endif()
    set(${output} "${count}" PARENT_SCOPE)
endfunction()
function(require_json json expected)
    string(JSON actual ERROR_VARIABLE error GET "${json}" ${ARGN})
    if(error OR NOT "${actual}" STREQUAL "${expected}")
        display_contract_error("${ARGN}: expected ${expected}, got ${actual}")
    endif()
endfunction()
function(check_fields json)
    string(JSON count LENGTH "${json}")
    if(count GREATER 0)
        math(EXPR last "${count}-1")
        foreach(index RANGE ${last})
            string(JSON key MEMBER "${json}" ${index})
            if(NOT key IN_LIST ARGN)
                display_contract_error("unsupported reflection field ${key}")
            endif()
        endforeach()
    endif()
endfunction()
function(check_io json key type optional)
    json_count(count "${json}" "${key}")
    if(count EQUAL 0 AND optional)
        return()
    endif()
    if(NOT count EQUAL 1)
        display_contract_error("${key} must have one location-0 ${type}")
    endif()
    string(JSON io GET "${json}" "${key}" 0)
    check_fields("${io}" type name location)
    require_json("${io}" "${type}" type)
    require_json("${io}" 0 location)
endfunction()
function(check_display_shader file stage constants)
    execute_process(COMMAND "${SPIRV_VAL}" --target-env vulkan1.3 "${file}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(NOT result STREQUAL "0")
        display_contract_error("SPIR-V validation: ${output}${error}")
    endif()
    execute_process(COMMAND "${SPIRV_DIS}" --raw-id "${file}"
        RESULT_VARIABLE result OUTPUT_VARIABLE assembly ERROR_VARIABLE error TIMEOUT 10)
    if(NOT result STREQUAL "0")
        display_contract_error("SPIR-V disassembly: ${error}")
    endif()
    string(REGEX MATCHALL "OpCapability [A-Za-z0-9_]+" capabilities "${assembly}")
    if(NOT capabilities STREQUAL "OpCapability Shader" OR assembly MATCHES "OpExtension ")
        display_contract_error("unsupported capabilities/extensions: ${capabilities}")
    endif()
    string(REGEX MATCHALL "OpExtInstImport [^\r\n]+" imports "${assembly}")
    foreach(import IN LISTS imports)
        if(NOT import STREQUAL "OpExtInstImport \"GLSL.std.450\"")
            display_contract_error("unsupported instruction set ${import}")
        endif()
    endforeach()
    string(REGEX MATCHALL "OpExecutionMode[^\r\n]+" modes "${assembly}")
    if(stage STREQUAL "fragment")
        if(NOT modes MATCHES "^OpExecutionMode %[0-9]+ OriginUpperLeft$")
            display_contract_error("unsupported fragment execution modes")
        endif()
    elseif(modes)
        display_contract_error("unexpected vertex execution modes")
    endif()
    # Disallow hidden interpolation, dual-source output, depth writes, or
    # descriptor-indexing decorations outside this fixed pipeline's ABI.
    string(REGEX MATCHALL "OpDecorate %[0-9]+ [A-Za-z0-9_]+" decorations "${assembly}")
    foreach(decoration IN LISTS decorations)
        if(NOT decoration MATCHES " (Binding|DescriptorSet|Location|Block|BuiltIn)$")
            display_contract_error("unsupported ${decoration}")
        endif()
    endforeach()
    string(REGEX MATCHALL "OpMemberDecorate %[0-9]+ [0-9]+ [A-Za-z0-9_]+" members "${assembly}")
    foreach(member IN LISTS members)
        if(NOT member MATCHES " Offset$")
            display_contract_error("unsupported ${member}")
        endif()
    endforeach()
    string(REGEX MATCHALL "BuiltIn [A-Za-z0-9_]+" builtins "${assembly}")
    list(SORT builtins)
    if(stage STREQUAL "vertex")
        if(NOT builtins STREQUAL "BuiltIn Position;BuiltIn VertexIndex")
            display_contract_error("vertex must use only VertexIndex and Position builtins")
        endif()
    elseif(builtins)
        display_contract_error("fragment builtins are outside the display ABI")
    endif()
    execute_process(COMMAND "${SPIRV_CROSS}" "${file}" --reflect
        RESULT_VARIABLE result OUTPUT_VARIABLE reflection ERROR_VARIABLE error TIMEOUT 10)
    if(NOT result STREQUAL "0")
        display_contract_error("SPIRV-Cross reflection: ${error}")
    endif()
    check_fields("${reflection}" entryPoints types inputs outputs separate_images separate_samplers push_constants)
    json_count(entries "${reflection}" entryPoints)
    if(NOT entries EQUAL 1)
        display_contract_error("expected one entry point")
    endif()
    require_json("${reflection}" "${stage}Main" entryPoints 0 name)
    json_count(images "${reflection}" separate_images)
    json_count(samplers "${reflection}" separate_samplers)
    json_count(pushes "${reflection}" push_constants)
    if(stage STREQUAL "vertex")
        require_json("${reflection}" vert entryPoints 0 mode)
        json_count(inputs "${reflection}" inputs)
        if(inputs OR images OR samplers OR pushes)
            display_contract_error("vertex input/resources are outside the generated-triangle ABI")
        endif()
        check_io("${reflection}" outputs vec2 FALSE)
    else()
        require_json("${reflection}" frag entryPoints 0 mode)
        check_io("${reflection}" inputs vec2 TRUE)
        check_io("${reflection}" outputs vec4 FALSE)
        if(images GREATER 1 OR samplers GREATER 1 OR pushes GREATER 1 OR (pushes AND NOT constants))
            display_contract_error("unexpected display resource count")
        endif()
        foreach(resource separate_images separate_samplers)
            json_count(count "${reflection}" "${resource}")
            if(count)
                string(JSON value GET "${reflection}" "${resource}" 0)
                check_fields("${value}" type name set binding)
                require_json("${value}" 0 set)
                if(resource STREQUAL "separate_images")
                    require_json("${value}" texture2D type)
                    require_json("${value}" 0 binding)
                else()
                    require_json("${value}" sampler type)
                    require_json("${value}" 1 binding)
                endif()
            endif()
        endforeach()
        if(pushes)
            string(JSON type GET "${reflection}" push_constants 0 type)
            string(JSON block GET "${reflection}" types "${type}")
            json_count(count "${block}" members)
            if(NOT count EQUAL 1)
                display_contract_error("push constants must be one float at offset 0")
            endif()
            string(JSON member GET "${block}" members 0)
            check_fields("${member}" type name offset)
            require_json("${member}" float type)
            require_json("${member}" 0 offset)
        endif()
    endif()
    file(WRITE "${file}.reflection.json" "${reflection}\n")
endfunction()
