cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run)
set(root "${TEST_ROOT}/${run}")
file(MAKE_DIRECTORY "${root}")
function(prepare_sources name)
    file(MAKE_DIRECTORY "${root}/${name}/sources")
    foreach(source display.slang hdr-range.slang)
        file(COPY_FILE "${SOURCE_ROOT}/${source}" "${root}/${name}/sources/${source}")
    endforeach()
endfunction()
function(run_case name compile published expected)
    file(MAKE_DIRECTORY "${root}/${name}/revision")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DREVISION=${root}/${name}/revision"
        "-DCOMPILE=${compile}" "-DSOURCE_ROOT=${root}/${name}/sources" "-DPUBLISHED_ROOT=${published}"
        -P "${UPDATE_SCRIPT}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${root}/${name}/result.log" "${output}${error}")
    if(expected STREQUAL "success")
        if(NOT result STREQUAL "0" OR NOT EXISTS "${root}/${name}/revision/ready")
            message(FATAL_ERROR "${name}: expected a complete revision: ${output}${error}")
        endif()
    elseif(result STREQUAL "0" OR NOT "${output}${error}" MATCHES "${expected}" OR
        (EXISTS "${root}/${name}/revision/ready" AND NOT expected STREQUAL "fresh revision directory"))
        message(FATAL_ERROR "${name}: wrong rejection: ${output}${error}")
    endif()
    message(STATUS "Shader update check passed: ${name}")
endfunction()
run_case(snapshot OFF "${PUBLISHED_ROOT}" success)
run_case(snapshot OFF "${PUBLISHED_ROOT}" "fresh revision directory")
prepare_sources(compile)
run_case(compile ON "" success)
file(READ "${root}/compile/revision/custom-display/fragment.spv" unchanged HEX)
foreach(name syntax binding constants array varying output entry capability)
    prepare_sources("${name}")
    file(READ "${root}/${name}/sources/display.slang" source)
    if(name STREQUAL "syntax")
        string(APPEND source "\ninvalid source text\n")
        set(expected "compilation failed")
    elseif(name STREQUAL "binding")
        string(REPLACE "binding(0, 0)" "binding(0, 1)" source "${source}")
        set(expected "contract rejected")
    elseif(name STREQUAL "constants")
        string(REPLACE "float exposureEV;" "float exposureEV; float extra;" source "${source}")
        set(expected "push constants must be one float")
    elseif(name STREQUAL "array")
        string(REPLACE "hdrTexture;" "hdrTexture[2];" source "${source}")
        string(REPLACE "hdrTexture.SampleLevel" "hdrTexture[0].SampleLevel" source "${source}")
        set(expected "unsupported reflection field array")
    elseif(name STREQUAL "varying")
        string(REPLACE "float2 uv : TEXCOORD0;" "[[vk::location(1)]] float2 uv : TEXCOORD0;" source "${source}")
        set(expected "contract rejected")
    elseif(name STREQUAL "output")
        string(REPLACE "float4 fragmentMain" "float3 fragmentMain" source "${source}")
        string(REPLACE "return float4(exposed/(1+exposed),1);" "return exposed/(1+exposed);" source "${source}")
        set(expected "contract rejected")
    elseif(name STREQUAL "entry")
        string(REPLACE "fragmentMain" "wrongMain" source "${source}")
        set(expected "compilation failed")
    else()
        string(REPLACE "float3 exposed=" "radiance.x=float(sqrt(double(radiance.x)));\n    float3 exposed=" source "${source}")
        set(expected "unsupported capabilities|compilation failed")
    endif()
    file(WRITE "${root}/${name}/sources/display.slang" "${source}")
    run_case("${name}" ON "" "${expected}")
endforeach()
foreach(name hash missing)
    file(MAKE_DIRECTORY "${root}/${name}/published")
    foreach(package custom-display custom-hdr-range)
        file(COPY "${root}/snapshot/revision/${package}" DESTINATION "${root}/${name}/published")
    endforeach()
    if(name STREQUAL "hash")
        file(APPEND "${root}/${name}/published/custom-display/fragment.spv" "bad")
        set(expected "snapshot hash mismatch")
    else()
        # Replace a required file with a directory, without deleting a fixture.
        file(RENAME "${root}/${name}/published/custom-display/manifest.txt" "${root}/${name}/published/custom-display/saved-manifest.txt")
        file(MAKE_DIRECTORY "${root}/${name}/published/custom-display/manifest.txt")
        set(expected "file failed to open|file STRINGS|file READ|file does not exist|Is a directory|Permission denied")
    endif()
    run_case("${name}" OFF "${root}/${name}/published" "${expected}")
endforeach()
file(READ "${root}/compile/revision/custom-display/fragment.spv" retained HEX)
if(NOT retained STREQUAL unchanged)
    message(FATAL_ERROR "An earlier immutable revision changed during failures")
endif()
message(STATUS "Shader update checks: 13 cases passed; ${root}")
