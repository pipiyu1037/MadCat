cmake_minimum_required(VERSION 3.25)
set(SLANGC "@MADCAT_SLANGC@")
set(SPIRV_VAL "@MADCAT_SPIRV_VAL@")
set(SPIRV_DIS "@MADCAT_SPIRV_DIS@")
set(SPIRV_CROSS "@MADCAT_SPIRV_CROSS@")
set(EXPECTED_SLANG_VERSION "@MADCAT_SLANG_VERSION@")
set(compile_script "@PROJECT_SOURCE_DIR@/cmake/CompileShaders.cmake")
include("@PROJECT_SOURCE_DIR@/cmake/CheckDisplayShader.cmake")
foreach(tool SLANGC SPIRV_VAL SPIRV_DIS SPIRV_CROSS)
    if(NOT EXISTS "${${tool}}")
        message(FATAL_ERROR "Shader update tool unavailable: ${tool}=${${tool}}; configure again")
    endif()
endforeach()
if(NOT IS_DIRECTORY "${REVISION}" OR EXISTS "${REVISION}/attempted")
    message(FATAL_ERROR "Shader update requires a fresh revision directory")
endif()
file(WRITE "${REVISION}/attempted" "Immutable display Shader candidate\n")
if(COMPILE)
    # Capture both source files before compiling either package. All stages
    # and all swapchain image plans subsequently use these fixed bytes.
    file(MAKE_DIRECTORY "${REVISION}/sources")
    file(COPY_FILE "${SOURCE_ROOT}/display.slang" "${REVISION}/sources/display.slang")
    file(COPY_FILE "${SOURCE_ROOT}/hdr-range.slang" "${REVISION}/sources/hdr-range.slang")
else()
    # Coordinate with the existing explicit build targets during startup copy.
    file(LOCK "${PUBLISHED_ROOT}/.compile.lock" GUARD PROCESS TIMEOUT 10 RESULT_VARIABLE lock_result)
    if(NOT lock_result STREQUAL "0")
        message(FATAL_ERROR "Cannot snapshot published Shader packages: ${lock_result}")
    endif()
endif()
foreach(package custom-display custom-hdr-range)
    if(COMPILE)
        if(package STREQUAL "custom-display")
            set(source "${REVISION}/sources/display.slang")
        else()
            set(source "${REVISION}/sources/hdr-range.slang")
        endif()
        execute_process(COMMAND "@CMAKE_COMMAND@" "-DSLANGC=${SLANGC}" "-DSPIRV_VAL=${SPIRV_VAL}"
            "-DEXPECTED_SLANG_VERSION=${EXPECTED_SLANG_VERSION}" "-DSOURCE_FILE=${source}"
            "-DSHADER_PACKAGE=${package}" "-DOUTPUT_ROOT=${REVISION}" -P "${compile_script}"
            RESULT_VARIABLE result TIMEOUT 25)
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "Shader compilation rejected: ${package} (${result})")
        endif()
    else()
        file(COPY "${PUBLISHED_ROOT}/${package}" DESTINATION "${REVISION}")
    endif()
    set(directory "${REVISION}/${package}")
    file(READ "${directory}/manifest.txt" manifest)
    if(NOT manifest MATCHES "^Slang: ${EXPECTED_SLANG_VERSION}\n")
        message(FATAL_ERROR "Unexpected compiler in ${package}")
    endif()
    foreach(file vertex.spv fragment.spv "${package}.slang")
        if(file STREQUAL "${package}.slang")
            set(label "Source")
        else()
            set(label "${file}")
        endif()
        file(SHA256 "${directory}/${file}" actual)
        string(REGEX MATCHALL "${label} SHA256: [0-9a-f]+" hashes "${manifest}")
        if(NOT hashes STREQUAL "${label} SHA256: ${actual}")
            message(FATAL_ERROR "Shader snapshot hash mismatch: ${package}/${file}")
        endif()
    endforeach()
    check_display_shader("${directory}/vertex.spv" vertex 0)
    if(package STREQUAL "custom-display")
        set(constants 4)
    else()
        set(constants 0)
    endif()
    check_display_shader("${directory}/fragment.spv" fragment ${constants})
endforeach()
# The caller never prepares GPU objects from an incomplete candidate.
file(WRITE "${REVISION}/ready" "Display Shader contract v1\n")
message(STATUS "Complete display Shader revision: ${REVISION}")
